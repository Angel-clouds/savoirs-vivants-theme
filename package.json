{
  "name": "savoirs-vivants",
  "version": "0.2.0",
  "private": true,
  "description": "Thème WordPress FSE sur-mesure de l'association Savoirs Vivants",
  "scripts": {
    "vendor": "rm -rf assets/vendor/tarteaucitron && mkdir -p assets/vendor && cp -r node_modules/tarteaucitronjs assets/vendor/tarteaucitron",
    "dev": "tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --watch",
    "build": "npm run vendor && tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --minify"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tarteaucitronjs": "^1.34.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
