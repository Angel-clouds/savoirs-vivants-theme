{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "75rem"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "palette": [
        { "slug": "bleu-nuit", "name": "Bleu nuit", "color": "#222A60" },
        { "slug": "vert-sauge", "name": "Vert sauge (grands titres, décor)", "color": "#16987C" },
        { "slug": "vert-sauge-texte", "name": "Vert sauge foncé (textes, liens)", "color": "#117A63" },
        { "slug": "blanc", "name": "Blanc", "color": "#FFFFFF" },
        { "slug": "gris-clair", "name": "Gris clair (fonds)", "color": "#F7F7F7" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "letterSpacing": false,
      "writingMode": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Space Mono (titres)",
          "slug": "space-mono",
          "fontFamily": "\"Space Mono\", ui-monospace, monospace",
          "fontFace": [
            { "fontFamily": "Space Mono", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-latin-400-normal.woff2"] },
            { "fontFamily": "Space Mono", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-latin-700-normal.woff2"] },
            { "fontFamily": "Space Mono", "fontWeight": "700", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-latin-700-italic.woff2"] }
          ]
        },
        {
          "name": "Space Grotesk (texte)",
          "slug": "space-grotesk",
          "fontFamily": "\"Space Grotesk\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Space Grotesk", "fontWeight": "300 700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-grotesk-latin-wght-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Petit", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
        { "slug": "large", "name": "Grand", "size": "1.625rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
        { "slug": "x-large", "name": "Très grand", "size": "2rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
        { "slug": "xx-large", "name": "Titre de page", "size": "2.75rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
      ]
    },
    "spacing": {
      "units": ["rem", "%"],
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "1rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "clamp(1.5rem, 4vw, 2rem)" },
        { "slug": "50", "name": "XL", "size": "clamp(2rem, 5vw, 3rem)" },
        { "slug": "60", "name": "2XL", "size": "clamp(2.5rem, 7vw, 4.5rem)" },
        { "slug": "70", "name": "Section", "size": "clamp(3rem, 9vw, 6rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|blanc",
      "text": "var:preset|color|bleu-nuit"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|space-grotesk",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|30",
      "padding": {
        "left": "var:preset|spacing|30",
        "right": "var:preset|spacing|30"
      }
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|space-mono", "fontWeight": "700", "lineHeight": "1.2" },
        "color": { "text": "var:preset|color|bleu-nuit" }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h3": {
        "typography": { "fontSize": "var:preset|font-size|large", "fontStyle": "italic" },
        "color": { "text": "var:preset|color|vert-sauge" }
      },
      "h4": {
        "typography": { "fontSize": "var:preset|font-size|medium", "textTransform": "uppercase" }
      },
      "link": {
        "color": { "text": "var:preset|color|vert-sauge-texte" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|bleu-nuit" } }
      },
      "button": {
        "color": { "background": "var:preset|color|bleu-nuit", "text": "var:preset|color|blanc" },
        "typography": { "fontFamily": "var:preset|font-family|space-mono", "fontWeight": "700", "fontSize": "var:preset|font-size|small", "textTransform": "uppercase" },
        "border": { "radius": "0" },
        "spacing": { "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.5rem", "right": "1.5rem" } },
        ":hover": { "color": { "background": "var:preset|color|vert-sauge-texte" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "En-tête", "area": "header" },
    { "name": "footer", "title": "Pied de page", "area": "footer" }
  ]
}